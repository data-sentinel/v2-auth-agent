# DS-Auth Configuration
DS_AUTH_IMAGE=ds-auth:latest
DS_AUTH_PORT=7001
# local | sso | both
DS_AUTH_MODE=local

# Base URL of the Data Sentinel PostgREST API (used to provision SSO users on first login)
DS_API_BASE_URL=http://ds_dbapi:3000
SSO_LOGIN_URL=/auth/oauth2/start?rd=/auth/sso/callback
# Defaults to / (the app's root route takes the user on); set only if you need something else
# SSO_POST_LOGIN_REDIRECT_URL=/
# false only for a plain-http local setup
COOKIE_SECURE=true
# true exposes /sso/debug (returns all headers incl. Azure token) - never in prod
SSO_DEBUG=false
# Empty = same-origin via nginx
CORS_ALLOW_ORIGIN=
# Dev only (disable in prod): SSO redirect adds #ds_token=<jwt> for localhost/127.0.0.1 — SPA must read hash and store token; leave unset/false otherwise
DS_AUTH_DEV_LOCALHOST_SSO_FRAGMENT=1

JWT_EXP_MIN=480

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=database-name
DB_USER=postgres
DB_PASSWORD=password

# Production Settings
COMPOSE_PROJECT_NAME=ds-auth-prod
COMPOSE_FILE=docker-compose.server.yml

# ---------------------------------------------------------------------------
# SSO - Office 365 / Azure AD (Microsoft Entra ID)
# ---------------------------------------------------------------------------
# Step 1: Register an App in Azure Portal → App registrations
# Step 2: Fill in the three values below from the App registration page
AZURE_TENANT_ID=tenant-id
AZURE_CLIENT_ID=client-id
AZURE_CLIENT_SECRET=client-secret

# Restrict login to a specific domain (e.g. company.com) or * for any O365 user
AZURE_EMAIL_DOMAIN=*

# oauth2-proxy session cookie secret — MUST be exactly 16, 24, or 32 bytes
# Generate with:  openssl rand -base64 24 | tr -d '\n'
OAUTH2_COOKIE_SECRET=cookie-secret

# Full public URL that Azure AD will redirect back to after login
# Format: http(s)://<your-server-ip-or-hostname>:<OAUTH2_PROXY_PORT>/oauth2/callback
SSO_REDIRECT_URL=https://<ip-or-hostname>/auth/oauth2/callback

# Port on which oauth2-proxy will listen (this is what the browser/frontend hits)
OAUTH2_PROXY_PORT=4180

